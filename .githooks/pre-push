#!/bin/sh
# HomeCrew pre-push hook.
#
#   1. every branch being pushed must match the agreed name format
#   2. the full Maven gate must pass
#
# The branch loop lives here rather than in checks/branch-name.sh because git
# supplies the refs being pushed on stdin, which may not be the current branch.

set -eu

HOOK_NAME="pre-push"
export HOOK_NAME
. "$(dirname "$0")/common.sh"

ZERO='0000000000000000000000000000000000000000'

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
checked_any=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_ref:-}" ] && continue

    # Branch deletion: nothing to validate or build.
    [ "$local_sha" = "$ZERO" ] && continue

    case "$local_ref" in
        refs/heads/*)
            info "checking branch name..."
            check_branch_name "${local_ref#refs/heads/}"
            checked_any=1
            ;;
        *)
            # Tags and other refs are out of scope for the branch rule.
            ;;
    esac
done

# Invoked manually, or nothing readable on stdin: fall back to HEAD.
if [ "$checked_any" -eq 0 ]; then
    check_branch_name "$(current_branch)"
fi

ok "branch name valid"

run_check build.sh
