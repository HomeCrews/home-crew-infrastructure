# The runtime every service uses locally. Deliberately contains no application.
#
# A service's code arrives on a bind mount and is compiled inside the container
# by dev-reload.sh, so this image only has to provide a toolchain. That is also
# why all twelve services share one image: there is nothing service-specific to
# bake in, and building it once beats building twelve.
#
# JDK, not JRE, unlike the production Dockerfiles: javac has to be in here, and
# dev-reload.sh also uses javap to find the main class, the way spring-boot:run
# does, and test/ uses jcmd to inspect the running application. Nothing in this
# file is used by a deployed image; those are built from the Dockerfile in each
# service repository.
FROM eclipse-temurin:25-jdk

# curl so probing a container by hand works exactly as it does against a
# production image, which installs curl for the compose healthchecks - and
# because dev-reload.sh's readiness check is a curl against the application's
# own port.
#
# procps for ps and pgrep, when you exec in to see what is running and for
# test/. dev-reload.sh no longer needs pkill: the application is its direct
# child now, not a JVM forked by Maven that could outlive the process it was
# asked to stop with.
#
# flock is not installed here because it does not need to be: util-linux is part
# of the base image, and dev-reload.sh uses it to install the Maven wrapper's
# distribution once for all twelve containers. test/ checks it is present.
#
# git because the shared pom-plugins.xml shells out to it at the validate phase
# to point core.hooksPath at .githooks. dev-reload.sh skips that execution with
# -Dhooks.install.skip=true, since those hooks belong to the host's clone rather
# than to a container - but git is installed anyway, because the assumption that
# it is on PATH during a Maven build is baked into the build and something else
# will eventually rely on it. Without it the build dies in its first phase with
# "Cannot run program git (in directory /app)".
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl procps git \
    && rm -rf /var/lib/apt/lists/*

# /app is a bind mount owned by the host user, not by root. Git refuses to
# operate on a repository it believes belongs to someone else ("detected dubious
# ownership"), so any git command in here would fail on that rather than on
# anything real.
RUN git config --global --add safe.directory /app

WORKDIR /app

# Maven Daemon, for every build dev-reload.sh runs - the compile loop and the
# dependency:build-classpath that the application's classpath comes from.
#
# `mvn compile` spends most of its time booting a JVM and re-checking the
# dependency tree rather than compiling - 5-10s for a module with three source
# files. mvnd keeps a warm JVM between invocations, which is the difference
# between a ~10s edit-to-serving cycle and a ~3s one.
#
# The failure here is deliberately NOT fatal. mvnd's release asset naming has
# changed across versions, and getting it wrong should cost you the speed-up
# rather than the whole dev environment: dev-reload.sh probes for a working
# mvnd at startup and falls back to sh ./mvnw, logging which one it picked.
#
# mvnd carries its own Maven (1.0.x embeds a 3.9.x), independent of the 3.9.16
# the wrapper pins. dev-reload.sh's lock settings need the resolver of Maven
# 3.9.x (1.9.12 or later) - check that still holds before bumping this.
ARG MVND_VERSION=1.0.2
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      arm64) arch=linux-aarch64 ;; \
      amd64) arch=linux-amd64 ;; \
      *)     arch="" ;; \
    esac; \
    if [ -z "$arch" ]; then \
      echo "WARNING: no mvnd build for $(dpkg --print-architecture); compiles will use ./mvnw"; \
    else \
      url="https://github.com/apache/maven-mvnd/releases/download/${MVND_VERSION}/maven-mvnd-${MVND_VERSION}-${arch}.tar.gz"; \
      if curl -fsSL "$url" -o /tmp/mvnd.tar.gz; then \
        mkdir -p /opt/mvnd; \
        tar -xzf /tmp/mvnd.tar.gz -C /opt/mvnd --strip-components=1; \
        ln -s /opt/mvnd/bin/mvnd /usr/local/bin/mvnd; \
        rm -f /tmp/mvnd.tar.gz; \
        echo "mvnd ${MVND_VERSION} installed for $arch"; \
      else \
        echo "WARNING: could not fetch $url; compiles will use ./mvnw"; \
      fi; \
    fi
