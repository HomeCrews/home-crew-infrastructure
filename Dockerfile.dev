# The runtime every service uses locally. Deliberately contains no application.
#
# A service's code arrives on a bind mount and is compiled inside the container
# by dev-reload.sh, so this image only has to provide a toolchain. That is also
# why all twelve services share one image: there is nothing service-specific to
# bake in, and building it once beats building twelve.
#
# JDK, not JRE, unlike the production Dockerfiles - javac has to be in here.
# Nothing in this file is used by a deployed image; those are built from the
# Dockerfile in each service repository.
FROM eclipse-temurin:25-jdk

# curl so probing a container by hand works exactly as it does against a
# production image, which installs curl for the compose healthchecks.
#
# procps for pkill, which dev-reload.sh needs to be sure the forked application
# JVM is gone before starting its replacement. It is not in the base image, and
# without it the fallback silently does nothing - which surfaces only as an
# occasional "address already in use" after a pom.xml change.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
