# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# On the Hetzner host this file lives at /opt/homecrew/.env and is written by
# .github/workflows/deploy.yml from GitHub environment secrets - do not edit it
# there by hand, the next deploy overwrites it.

# Postgres. The compose default is homecrew/homecrew for local use, and the
# services default to the same via ${DB_USERNAME:homecrew}/${DB_PASSWORD:homecrew}
# in home-crew-config. POSTGRES_PASSWORD has no default in docker-compose.yml on
# purpose: its absence must fail `docker compose config --quiet`.
POSTGRES_USER=homecrew
POSTGRES_PASSWORD=homecrew
POSTGRES_DB=homecrew

# There is deliberately no DB_USERNAME/DB_PASSWORD here. docker-compose.yml
# derives the container-side DB_USERNAME/DB_PASSWORD from POSTGRES_USER and
# POSTGRES_PASSWORD above, so the database and its clients cannot drift apart.

# Per-service memory ceiling for the local watch-mode stack (compose.dev.yml).
#
# A watched container runs three JVMs: Maven, the forked application, and
# another Maven every time the compile loop fires. The production figure of
# 192m does not fit any of that.
#
# This is a LIMIT, not a reservation - a service that needs 500m uses 500m. But
# twelve of these plus postgres and kafka is 13g of ceiling, and Docker
# Desktop's VM defaults to roughly half your host RAM, so on a 16g machine
# either raise the VM to 12g in Docker Desktop's settings or lower this:
#
#     DEV_SERVICE_MEM=768m
#
# Below about 640m the application JVM starts losing to the compile loop and
# restarts get slow rather than failing outright, which is a confusing way to
# run out of memory.
DEV_SERVICE_MEM=1g

# How often dev-reload.sh checks the bind mount for changes, in seconds.
#
# 2 is a good default: a single save is picked up within two seconds, and a
# burst of saves coalesces into one compile because the loop is serial - it is
# not polling while a compile is in flight, and the stamp is taken before the
# compile so nothing saved during one is lost.
#
# Raise it to 4 or 5 if you save in heavy bursts and would rather trade latency
# on a single save for fewer compiles. Lowering it below 1 buys nothing: the
# compile itself is the slow part, not the polling.
#
# Unlike DEV_SERVICE_MEM, this one has to reach the CONTAINER rather than just
# compose, so compose.dev.yml passes it through explicitly in every service's
# environment. Setting it here alone would do nothing.
DEV_RELOAD_INTERVAL=2

# webapp is Angular, not a JVM, so it gets its own two knobs.
#
# It runs one Node process rather than three JVMs, and typically sits well under
# 1g - but the Angular compiler is memory-hungry on a cold build, so the ceiling
# is the same as a service rather than the 64m the built nginx image needs.
WEBAPP_DEV_MEM=1g

# How often Angular's dev server polls the bind mount, in MILLISECONDS - note
# the different unit from DEV_RELOAD_INTERVAL above, which is seconds. Polling
# is required for the same reason: Docker Desktop's bind mounts do not propagate
# inotify events from the host.
WEBAPP_POLL_INTERVAL=2000

# config-server's encryption key. REQUIRED - docker-compose.yml declares it
# ${VAR?...}, so a missing one fails `docker compose config` outright.
#
# This is the one secret that unlocks every other secret: config-server uses it
# to decrypt the {cipher} values in home-crew-config before serving them. There
# is deliberately no default, because a fallback would decrypt every secret to
# garbage and the services would start with nonsense rather than not start.
#
# Generate one, and keep it somewhere you can recover it - losing it means
# re-encrypting every {cipher} value in home-crew-config:
#
#     openssl rand -base64 48
#
ENCRYPT_KEY=<generate-with-openssl-rand-base64-48>

# The password every service presents to config-server over HTTP basic.
#
# config-server hands out DECRYPTED secrets and exposes /decrypt, so it can no
# longer be open. localdev is a public default in the same sense as the postgres
# homecrew/homecrew pair: it only unlocks a config-server on your own machine.
# Set a real value for anything reachable by anyone else.
CONFIG_CLIENT_PASSWORD=localdev

# config-server's access to home-crew-config. That repository is PRIVATE, so
# both are REQUIRED - JGit registers no CredentialsProvider when the username is
# empty, and the clone then fails with "Authentication is required but no
# CredentialsProvider has been registered".
#
# A read-only token is enough: a classic PAT with `repo`, or a fine-grained
# token with Contents:read on home-crew-config only.
#
# The variables must be PRESENT even if home-crew-config is later made public -
# docker-compose.yml declares them ${VAR?...}, which allows empty but not
# missing, so they cannot be forgotten silently.
CONFIG_GIT_USERNAME=<github-username>
CONFIG_GIT_TOKEN=<github-token>
