# homecrew:standards:gitattributes:start
# Git hooks MUST be checked out with LF endings. On Windows, core.autocrlf
# would otherwise write CRLF, and the shell fails to parse the shebang with
# "bad interpreter: /bin/sh^M" - which reads as the hook being missing rather
# than mangled. This single rule is what makes the hooks work on Windows.
.githooks/** text eol=lf
*.sh        text eol=lf

# Normalise text in the repo, let git decide what is binary.
*           text=auto

# Windows batch files genuinely need CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf
# homecrew:standards:gitattributes:end
