# Secrets. .env holds live credentials and must never be committed;
# .env.example carries the key names with placeholder values instead.
.env
.env.*
!.env.example

# Generated by ./dev watch. Names the services you are hot-reloading and the
# debug port each one got, which is a per-session choice, not a repo-wide one.
.dev/

# OS / editor noise
.DS_Store
.idea/
*.iml
.vscode/
*.swp

# Local state
*.log
